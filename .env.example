# Reyting tizimi API manzili: https://<domen>/api/public
API_BASE_URL=http://127.0.0.1:8000/api/public
# Reyting tizimidagi QUESTIONS_API_KEY bilan bir xil bo'lishi kerak
API_KEY=
# Lokal sinovda o'z-o'zidan imzolangan sertifikat bo'lsa false qiling
VERIFY_SSL=true
# Har so'rovga qo'shiladigan cookie (masalan usenew=1); odatda bo'sh
API_COOKIE=

# Sahifani parol bilan yopish (bo'sh qoldirilsa ochiq)
APP_USER=admin
APP_PASSWORD=
